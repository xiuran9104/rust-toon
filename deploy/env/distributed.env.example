# Copy to a file outside git and replace every secret before deployment.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# The URI password must be percent-encoded when it contains @, /, :, # or %.
# It must decode to the same value as POSTGRES_PASSWORD above.
DATABASE_URL=postgres://rust_toon:replace-with-a-strong-database-password@postgres:5432/rust_toon
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes
S3_ACCESS_KEY=rust_toon
S3_SECRET_KEY=replace-with-a-strong-object-storage-secret
S3_BUCKET=rust-toon
S3_CONNECT_TIMEOUT_SECONDS=10
S3_REQUEST_TIMEOUT_SECONDS=30
S3_STREAM_TIMEOUT_SECONDS=1800
TOON_PROVIDER_VIDEO_CONCURRENCY=2
TOON_PROVIDER_VIDEO_MAX_BYTES=2147483648
TOON_PROVIDER_VIDEO_TEMP_QUOTA_BYTES=4294967296
TOON_WORKFLOW_STALE_SECONDS=7200
# For managed NATS, use a credentialed/TLS URL and the optional credential/TLS
# file settings documented in docs/configuration.md.
NATS_URL=nats://nats:4222
# NATS_CREDENTIALS_FILE=/run/secrets/nats.creds
# NATS_TLS_REQUIRED=true
# NATS_TLS_CA_FILE=/run/secrets/nats-ca.pem
# NATS_TLS_CLIENT_CERT_FILE=/run/secrets/nats-client.pem
# NATS_TLS_CLIENT_KEY_FILE=/run/secrets/nats-client.key

# r-nacos initializes this account on a new data volume. After bootstrap,
# create a dedicated application account and rotate NACOS_USERNAME/PASSWORD.
NACOS_USERNAME=replace-with-rnacos-bootstrap-admin
NACOS_PASSWORD=replace-with-a-strong-rnacos-password
NACOS_NAMESPACE=
NACOS_GROUP=RUST_TOON
NACOS_CONNECT_TIMEOUT_SECONDS=15
RNACOS_CLUSTER_TOKEN=replace-with-a-strong-rnacos-cluster-token
# At least 32 random bytes are required to enable the backup API.
RNACOS_BACKUP_TOKEN=replace-with-at-least-32-random-bytes
RNACOS_CONSOLE_PORT=10848

# Business traffic enters through edge. Data-plane maintenance endpoints are
# bound to loopback for host-level backups and monitoring.
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080
MAINTENANCE_BIND_ADDRESS=127.0.0.1
POSTGRES_MAINTENANCE_PORT=5432
RUSTFS_MAINTENANCE_PORT=9000
RUSTFS_CONSOLE_PORT=9001
NATS_MONITOR_PORT=8222

# The documented 1 gateway + 4 workers budget is 44 DB connections, leaving
# room below PostgreSQL's default 100-connection ceiling.
GATEWAY_DATABASE_MIN_CONNECTIONS=1
GATEWAY_DATABASE_MAX_CONNECTIONS=12
WORKER_DATABASE_MIN_CONNECTIONS=1
WORKER_DATABASE_MAX_CONNECTIONS=8
GATEWAY_DRAIN_DELAY_SECONDS=10
TOON_WORKER_CONCURRENCY=2
TOON_WORKER_LEASE_SECONDS=60
TOON_WORKER_HEARTBEAT_SECONDS=15
TOON_WORKER_DISPATCH_INTERVAL_MS=500
TOON_WORKER_SCHEDULER_INTERVAL_MS=1000
TOON_WORKER_PUBLISH_CLAIM_SECONDS=15
TOON_WORKER_REPUBLISH_AFTER_SECONDS=300
TOON_WORKER_REAPER_INTERVAL_SECONDS=5
TOON_WORKER_CLEANUP_INTERVAL_SECONDS=5
TOON_WORKER_CLEANUP_TIMEOUT_SECONDS=30
TOON_WORKER_STAGING_CLEANUP_DELAY_SECONDS=1800
TOON_WORKER_DRAIN_TIMEOUT_SECONDS=45
TOON_WORKER_MAX_SOURCE_BYTES=2147483648
TOON_WORKER_MAX_JOB_SOURCE_BYTES=10737418240
TOON_WORKER_SOURCE_TIMEOUT_SECONDS=1800
TOON_WORKER_FFMPEG_TIMEOUT_SECONDS=7200
TOON_WORKER_STALE_WORKDIR_SECONDS=604800
TOON_WORKER_ALLOW_HTTP_SOURCES=false
NATS_JOB_REPLICAS=1
NATS_JOB_MAX_BYTES=10737418240
NATS_JOB_ACK_WAIT_SECONDS=120
NATS_JOB_MAX_DELIVER=20
NATS_JOB_MAX_ACK_PENDING=32
RUST_LOG=info

# For a registry image, set this value, run `docker compose pull`, and start
# with `--no-build` as documented in docs/deployment.md.
# RUST_TOON_BACKEND_IMAGE=registry.example.com/rust-toon/backend:2026-08-26
