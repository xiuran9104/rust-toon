DATABASE_URL=postgres://rust_toon:replace-me@127.0.0.1:5432/rust_toon
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=12
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes
SECRET_ENCRYPTION_KEY=replace-with-a-distinct-random-secret-at-least-32-bytes
RATE_LIMIT_TRUST_PROXY_HEADERS=true
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=rust_toon
S3_SECRET_KEY=replace-with-a-strong-object-storage-secret
S3_BUCKET=rust-toon
S3_CONNECT_TIMEOUT_SECONDS=10
S3_REQUEST_TIMEOUT_SECONDS=30
S3_STREAM_TIMEOUT_SECONDS=1800
INFRA_UPLOAD_MAX_BYTES=20971520
TOON_PROVIDER_VIDEO_CONCURRENCY=2
TOON_PROVIDER_VIDEO_MAX_BYTES=2147483648
TOON_PROVIDER_VIDEO_TEMP_QUOTA_BYTES=4294967296
TOON_WORKER_SOURCE_TIMEOUT_SECONDS=1800
TOON_WORKFLOW_STALE_SECONDS=7200
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_DRAIN_DELAY_SECONDS=10
RUST_LOG=info
# Use json in production log pipelines; set text for local-compatible output.
TELEMETRY_LOG_FORMAT=json
TELEMETRY_METRICS_ENABLED=true
# Optional OTLP/gRPC tracing. No exporter is created while this is unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4317
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.internal:4317
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10000
# OTEL_SDK_DISABLED=false
RUST_ENV=production
READINESS_REQUIRE_REDIS=true
READINESS_REQUIRE_OBJECT_STORAGE=true
# Enable only on nodes expected to perform final video exports.
READINESS_REQUIRE_FFMPEG=false
# Optional runtime configuration subscription. Static environment values remain
# the fallback when the corresponding r-nacos document has not been published.
NACOS_ENABLED=true
NACOS_REQUIRED=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=RUST_TOON
NACOS_DATA_ID=rust-toon-gateway.json
NACOS_USERNAME=replace-with-a-config-read-user
NACOS_PASSWORD=replace-with-a-strong-config-user-password
NACOS_CACHE_DIR=/var/cache/rust-toon/nacos
NACOS_CONNECT_TIMEOUT_SECONDS=15
